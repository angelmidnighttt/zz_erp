{
  "name": "zz-erp-api",
  "version": "0.1.0",
  "private": true,
  "description": "ERP backend API (Node.js + Express + TypeScript)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "18",
    "tsx": "^4.23.15",
    "typescript": "^5.9"
  }
}
